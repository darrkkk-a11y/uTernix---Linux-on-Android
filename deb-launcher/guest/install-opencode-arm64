#!/bin/sh
# Adapt the one known OpenCode Desktop 2.2.6 .deb to native ARM64 Electron.
# No package maintainer scripts from that x86-64 .deb are run.
set -eu
[ "$#" -eq 1 ] || { printf '%s\n' 'Expected one .deb path' >&2; exit 2; }
deb=$1
expected_deb=87f66555f3a3fec3901ef7e1ac86f5e2deb55b90004cf42396e7547c6b195459
[ -f "$deb" ] || { printf '%s\n' 'OpenCode .deb is missing' >&2; exit 1; }
[ "$(sha256sum "$deb" | cut -d ' ' -f 1)" = "$expected_deb" ] || {
    printf '%s\n' 'OpenCode package checksum is not the supported 2.2.6 build' >&2; exit 1;
}
base=${DEB_LAUNCHER_APPS_DIR:-/opt/deb-launcher/apps}
desktop_dir=${DEB_LAUNCHER_DESKTOP_DIR:-/usr/share/applications}
runtime_dir=${DEB_LAUNCHER_RUNTIME_DIR:-/opt/deb-launcher/box64-0.4.4-v2}
final="$base/opencode-2.2.6"
desktop="$desktop_dir/deb-launcher-opencode.desktop"
mkdir -p "$base" "$desktop_dir"

if [ ! -e "$final" ]; then
    stage=$(mktemp -d "$base/.opencode-build.XXXXXXXX")
    cleanup() {
        # stage was created by this invocation, under this exact versioned base.
        case "$stage" in "$base"/.opencode-build.*) rm -rf -- "$stage" ;; esac
    }
    trap cleanup EXIT
    trap 'exit 130' HUP INT TERM
    mkdir -p "$stage/downloads" "$stage/unpacked" "$stage/runtime"
    curl -fL --retry 3 --connect-timeout 30 \
        'https://github.com/electron/electron/releases/download/v44.9.1/electron-v44.9.1-linux-arm64.zip' \
        -o "$stage/downloads/electron.zip"
    curl -fL --retry 3 --connect-timeout 30 \
        'https://registry.npmjs.org/@opencode/cli-linux-arm64/-/cli-linux-arm64-2.2.6.tgz' \
        -o "$stage/downloads/cli.tgz"
    curl -fL --retry 3 --connect-timeout 30 \
        'https://registry.npmjs.org/@lydell/node-pty-linux-arm64/-/node-pty-linux-arm64-1.2.0-beta.12.tgz' \
        -o "$stage/downloads/pty.tgz"
    printf '%s  %s\n' 16e1f8f7993ca45bc3c2594d75da9d0f3bbd66d691f8cc408747e135c49cb1ad "$stage/downloads/electron.zip" | sha256sum -c -
    printf '%s  %s\n' 22352e200630ec61a48a65b9f5c2b627328ae5002658d81c067f67c5fb689898 "$stage/downloads/cli.tgz" | sha256sum -c -
    printf '%s  %s\n' 7fe377bd4944f3722f50db97a0a439defc2b1faeea526659323b3dfc9e7c5a84 "$stage/downloads/pty.tgz" | sha256sum -c -
    dpkg-deb -x "$deb" "$stage/unpacked"
    src="$stage/unpacked/opt/OpenCode/resources"
    unzip -q "$stage/downloads/electron.zip" -d "$stage/runtime"
    mkdir -p "$stage/runtime/resources"
    tar -xOzf "$stage/downloads/cli.tgz" package/bin/opencode > "$stage/runtime/resources/opencode-cli"
    chmod 755 "$stage/runtime/resources/opencode-cli"
    cp "$src/opencode-cli.version" "$src/app-update.yml" "$src/package-type" "$stage/runtime/resources/"
    python3 "$runtime_dir/adapt-opencode-asar.py" "$src/app.asar" "$src/app.asar.unpacked" \
        "$stage/downloads/pty.tgz" "$stage/runtime/resources/app"
    # A real copy, not a hard link: Electron's executable name selects packaged mode.
    cp "$stage/runtime/electron" "$stage/runtime/ai.opencode"
    cp "$runtime_dir/opencode-start" "$stage/runtime/start"
    cp "$stage/unpacked/usr/share/icons/hicolor/128x128/apps/ai.opencode.png" "$stage/runtime/icon.png"
    chmod 755 "$stage/runtime/ai.opencode" "$stage/runtime/start"
    printf '%s\n' "$expected_deb" > "$stage/runtime/.deb-launcher-ready"
    # -n never overwrites an installation produced by another invocation.
    mv -T -n "$stage/runtime" "$final"
    [ ! -e "$stage/runtime" ] || { printf '%s\n' 'OpenCode destination appeared concurrently' >&2; exit 1; }
fi

# Всегда убеждаемся, что нужные библиотеки для OpenCode/Cursor установлены,
# даже если адаптация уже существует (повторный запуск не должен пропускать их).
export DEBIAN_FRONTEND=noninteractive
apt-get update
apt-get install -y --no-install-recommends --no-remove \
    ca-certificates curl unzip python3 libgtk-3-0t64 libnotify4 libnss3 \
    libnspr4 libxss1 libxtst6 xdg-utils libatspi2.0-0t64 libuuid1 \
    libsecret-1-0 libasound2t64 libatk-bridge2.0-0 libatk-bridge2.0-0t64 libatk1.0-0t64 \
    libcups2t64 libdbus-1-3 libexpat1 libgbm1 libglib2.0-0t64 \
    libx11-6 libxcomposite1 libxdamage1 libxext6 libxfixes3 libxrandr2 \
    libxcb1 libxkbcommon0 libudev1 libpango-1.0-0 libcairo2 \
    libsm6 libice6

[ -f "$final/.deb-launcher-ready" ] && [ "$(cat "$final/.deb-launcher-ready")" = "$expected_deb" ] &&
    [ -x "$final/start" ] && [ -x "$final/ai.opencode" ] || {
    printf '%s\n' 'Existing OpenCode destination differs; it was not overwritten' >&2; exit 1;
}
if [ ! -e "$desktop" ]; then
    (set -C; cat > "$desktop" <<EOF
[Desktop Entry]
Name=OpenCode
Exec=$final/start %U
Terminal=false
Type=Application
Icon=$final/icon.png
StartupWMClass=ai.opencode.desktop
Categories=Development;
EOF
    ) || { printf '%s\n' 'Could not create launcher entry without overwriting it' >&2; exit 1; }
else
    grep -Fxq "Exec=$final/start %U" "$desktop" || {
        printf '%s\n' 'Existing OpenCode launcher entry differs; it was not overwritten' >&2; exit 1;
    }
fi
printf '%s\n' 'OpenCode 2.2.6 ARM64 adaptation is ready.'
